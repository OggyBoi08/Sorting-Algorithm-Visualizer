				<Option type="1" />
				<Option compiler="gcc-msys2-mingw64" />
			</Target>
		</Build>
		<Compiler>
			<Add directory="../../../../../../msys64/mingw64/include" />
		</Compiler>
		<Linker>
			<Add library="SDL3" />
			<Add directory="../../../../../../msys64/mingw64/lib" />
		</Linker>
		<Unit filename="main.cpp" />
		<Unit filename="render.cpp" />
